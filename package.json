{
  "name": "dsh-plugin-test-button",
  "version": "0.1.0",
  "type": "module",
  "description": "Session header button that self-tests the DeepSeek Harness plugin you are writing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-JT-Shen/dsh-plugin-test-button.git"
  },
  "homepage": "https://github.com/William-JT-Shen/dsh-plugin-test-button#readme",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "plugin",
    "testing"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "probe.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
