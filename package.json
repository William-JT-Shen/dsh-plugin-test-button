{
  "name": "@local/dsh-plugin-test-button",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "在会话头部添加“测试插件”按钮：一键自检当前正在开发的 DeepSeek Harness 插件",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "probe.mjs",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
